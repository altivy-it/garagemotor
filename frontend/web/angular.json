{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "garagemotor-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "gm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "src/assets", "output": "assets" }],
            "outputPath": "dist/garagemotor-web"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "shared": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "baseHref": "/garagemotor/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "allowedHosts": ["nginx", "localhost", "127.0.0.1"]
          },
          "configurations": {
            "production": {
              "buildTarget": "garagemotor-web:build:production"
            },
            "development": {
              "buildTarget": "garagemotor-web:build:development"
            },
            "shared": {
              "buildTarget": "garagemotor-web:build:shared",
              "servePath": "/garagemotor/"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
