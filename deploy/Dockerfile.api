ARG DOTNET_SDK_IMAGE=docker.io/lzocateli/dotnet-sdk:10.0.403-noble-v1@sha256:b3a7f0bea815888d9b4516a1d02c6369c140d092608896c53cd3141bebdea315
ARG ASPNET_RUNTIME_IMAGE=docker.io/lzocateli/dotnet-aspnet:10.0.14-noble-v1@sha256:779a9cbc0ecd4ec5151b63fbf87e51aac6ba875c31a36148f63d841b76d4e621

FROM ${DOTNET_SDK_IMAGE} AS development
USER 0:0
WORKDIR /workspace
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_CLI_HOME=/tmp/dotnet
COPY global.json ./
COPY backend/ ./backend/
RUN dotnet restore backend/GarageMotor.Api/GarageMotor.Api.csproj --configfile backend/NuGet.Config --locked-mode \
    && dotnet build backend/GarageMotor.Api/GarageMotor.Api.csproj --no-restore --configuration Debug
WORKDIR /workspace/backend/GarageMotor.Api
ENV ASPNETCORE_URLS=http://+:8080
RUN install -d -o 1654 -g 1654 /var/lib/garagemotor/keys
USER 1654:1654
EXPOSE 8080
CMD ["dotnet", "run", "--no-build", "--no-restore", "--urls", "http://0.0.0.0:8080"]

FROM development AS publish
USER 0:0
RUN dotnet publish GarageMotor.Api.csproj --configuration Release --no-restore --output /out /p:UseAppHost=false

FROM ${ASPNET_RUNTIME_IMAGE} AS production
USER 0:0
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
COPY --from=publish /out/ ./
COPY backend/GarageMotor.Api/Migrations/ ./Migrations/
COPY specs/001-garagem-pessoal/contracts/openapi.json specs/001-garagem-pessoal/contracts/resources.schema.json ./contracts/
COPY LICENSE NOTICE.md ./
RUN install -d -o 1654 -g 1654 /var/lib/garagemotor/keys
USER 1654:1654
EXPOSE 8080
ENTRYPOINT ["dotnet", "GarageMotor.Api.dll"]
