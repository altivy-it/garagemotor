ARG NODE_IMAGE=docker.io/library/node:24.22.2-bookworm-slim@sha256:c0a93797ee78814ae6d32fcca2561fdbbe423149c3f5389aad32d86e9fd85bd4
ARG NGINX_IMAGE=docker.io/library/nginx:1.30.6@sha256:909063468649748c84e0fa2a67869c7b0b2d431c72b73cf654e4052f1e2d2937

FROM ${NODE_IMAGE} AS development
WORKDIR /app
COPY frontend/web/package.json frontend/web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --fund=false
COPY --chown=node:node frontend/web/ ./
RUN chown node:node /app
USER node
EXPOSE 4200
CMD ["npm", "exec", "--", "ng", "serve", "--host", "0.0.0.0", "--port", "4200"]

FROM development AS build
RUN npm exec -- ng build --configuration production

FROM ${NGINX_IMAGE} AS production
COPY deploy/nginx.web.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist/garagemotor-web/browser/ /usr/share/nginx/html/
COPY LICENSE NOTICE.md /usr/share/garagemotor/
USER 101:101
EXPOSE 4200
ENTRYPOINT ["nginx", "-g", "daemon off;"]
